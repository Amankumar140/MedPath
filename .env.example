# ==============================================================================
# MEDPATH - GLOBAL ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env in respective microservices or root directory.

# ------------------------------------------------------------------------------
# 1. CLIENT FRONTEND ENVIRONMENT (client/.env.example)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# ------------------------------------------------------------------------------
# 2. SERVER NODE.JS BACKEND ENVIRONMENT (server/.env.example)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
JWT_SECRET=your_jwt_secret_change_me_in_production
SESSION_SECRET=your_session_secret_change_me_in_production

# Database & Caching
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medpath?schema=public"
REDIS_URL="redis://localhost:6379"

# Downstream AI Services
SWASTHYA_API_URL="https://swasthya-ai-core.onrender.com"
PYTHON_MICROSERVICE_URL="https://medpath-microservices.onrender.com"
CLIENT_URL="https://medpath-v1-ak.vercel.app"

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. LLM MICROSERVICE ENVIRONMENT (llm/.env.example)
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=your_mistral_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
PORT=8000
LOG_LEVEL=INFO
